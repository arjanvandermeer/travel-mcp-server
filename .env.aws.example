# AWS Deployment Configuration
# Copy this to .env.aws and fill in your values

# AWS Account & Region
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1

# RDS PostgreSQL
RDS_ENDPOINT=travel-postgres.xxxxxxxxx.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=travel
RDS_USERNAME=traveluser
RDS_PASSWORD=your-secure-password

# Full DATABASE_URL for Fargate (constructed from above)
# DATABASE_URL=postgresql://${RDS_USERNAME}:${RDS_PASSWORD}@${RDS_ENDPOINT}:${RDS_PORT}/${RDS_DATABASE}

# ECR Repository
ECR_REPOSITORY=travel-mcp-server
ECR_IMAGE_URI=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}

# ECS Configuration
ECS_CLUSTER=travel-mcp-cluster
ECS_SERVICE=travel-mcp-service
ECS_TASK_DEFINITION=travel-mcp-task

# Networking (fill in after VPC setup)
VPC_ID=vpc-xxxxxxxxx
SUBNET_1=subnet-xxxxxxxxx
SUBNET_2=subnet-xxxxxxxxx
ALB_SECURITY_GROUP=sg-xxxxxxxxx
ECS_SECURITY_GROUP=sg-xxxxxxxxx
RDS_SECURITY_GROUP=sg-xxxxxxxxx

# ALB
ALB_ARN=arn:aws:elasticloadbalancing:us-east-1:${AWS_ACCOUNT_ID}:loadbalancer/app/hotel-mcp-alb/xxxxxxxxx
TARGET_GROUP_ARN=arn:aws:elasticloadbalancing:us-east-1:${AWS_ACCOUNT_ID}:targetgroup/hotel-mcp-targets/xxxxxxxxx
