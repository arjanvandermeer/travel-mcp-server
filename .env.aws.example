# AWS Deployment Configuration
# Copy this to .env.aws and fill in your values

# AWS Account & Region
AWS_ACCOUNT_ID=<account-id>
AWS_REGION=<region>

# RDS PostgreSQL
RDS_ENDPOINT=<rds-endpoint>
RDS_PORT=5432
RDS_DATABASE=travel
RDS_USERNAME=<user>
RDS_PASSWORD=<password>

# Full DATABASE_URL for Fargate (constructed from above)
# DATABASE_URL=postgresql://${RDS_USERNAME}:${RDS_PASSWORD}@${RDS_ENDPOINT}:${RDS_PORT}/${RDS_DATABASE}

# ECR Repository
ECR_REPOSITORY=<ecr-repository>
ECR_IMAGE_URI=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPOSITORY}

# ECS Configuration
ECS_CLUSTER=<ecs-cluster>
ECS_SERVICE=<ecs-service>
ECS_TASK_DEFINITION=<ecs-task>

# Networking (fill in after VPC setup)
VPC_ID=vpc-xxxxxxxxx
SUBNET_1=subnet-xxxxxxxxx
SUBNET_2=subnet-xxxxxxxxx
ALB_SECURITY_GROUP=sg-xxxxxxxxx
ECS_SECURITY_GROUP=sg-xxxxxxxxx
RDS_SECURITY_GROUP=sg-xxxxxxxxx

# ALB
ALB_ARN=arn:aws:elasticloadbalancing:<region>:<account-id>:loadbalancer/app/<alb-name>/xxxxxxxxx
TARGET_GROUP_ARN=arn:aws:elasticloadbalancing:<region>:<account-id>:targetgroup/<target-group-name>/xxxxxxxxx
