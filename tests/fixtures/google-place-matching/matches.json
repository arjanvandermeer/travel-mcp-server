{
  "version": 1,
  "description": "Deterministic Google Places matching regression cases. These fixtures are intentionally database-free and network-free.",
  "cases": [
    {
      "id": "roxy-address-alias-rescue",
      "description": "A borderline Roxy name should match when house number, distance, type, and 6th Ave / Avenue of the Americas evidence line up.",
      "poi": {
        "osm_id": 250052719,
        "poi_type": "hotel",
        "name": "Roxy Hotel",
        "latitude": 40.71920152727273,
        "longitude": -74.00489699090907,
        "tags": {
          "addr:housenumber": "2",
          "addr:street": "Avenue of the Americas"
        }
      },
      "candidates": [
        {
          "id": "roxy-google",
          "displayName": { "text": "Roxy NYC" },
          "formattedAddress": "2 6th Ave, New York, NY 10013, USA",
          "location": { "latitude": 40.719404, "longitude": -74.004902 },
          "types": ["hotel", "lodging"]
        },
        {
          "id": "nearby-loft",
          "displayName": { "text": "The Artist's Loft" },
          "formattedAddress": "8 6th Ave, New York, NY 10013, USA",
          "location": { "latitude": 40.71995, "longitude": -74.00494 },
          "types": ["lodging"]
        }
      ],
      "expected": {
        "selectedId": "roxy-google",
        "selected": {
          "accepted": true,
          "directNameMatch": false,
          "addressRescue": true,
          "houseNumberMatch": true,
          "streetMatch": true,
          "maxNameScore": 0.69,
          "minConfidence": 0.7
        }
      }
    },
    {
