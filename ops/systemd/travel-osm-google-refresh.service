[Unit]
Description=Travel MCP OSM and Google Places refresh
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/travel-mcp-server
EnvironmentFile=/etc/travel-mcp-server/refresh.env
ExecStart=/usr/bin/npm run db:refresh -- --max=2 --optimize --refresh-google
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
