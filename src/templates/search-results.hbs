<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon.png" type="image/png">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f5f5f5;
      color: #333;
      line-height: 1.5;
      padding: 16px;
    }
    .header {
      margin-bottom: 16px;
    }
    .header h1 {
      font-size: 20px;
      color: #333;
    }
    .header .count {
      font-size: 14px;
      color: #666;
      margin-top: 4px;
    }
    .toolbar {
      display: flex;
      gap: 8px;
      margin: 12px 0;
      overflow-x: auto;
      padding-bottom: 2px;
    }
    .filter-chip {
      border: 1px solid #d7dce8;
      background: #fff;
      border-radius: 999px;
      padding: 6px 10px;
      color: #4b5563;
      font-size: 12px;
      font-weight: 650;
      white-space: nowrap;
    }
    .filter-chip.active {
      border-color: #667eea;
      background: rgba(102, 126, 234, .1);
      color: #4f46e5;
    }
    .map-panel {
      position: relative;
      height: 180px;
      margin-bottom: 14px;
      overflow: hidden;
      border: 1px solid #d7dce8;
      border-radius: 12px;
      background:
        linear-gradient(90deg, rgba(255,255,255,.55) 1px, transparent 1px),
        linear-gradient(rgba(255,255,255,.55) 1px, transparent 1px),
        linear-gradient(135deg, #d9f0ec, #eef2ff 54%, #f9efe0);
      background-size: 28px 28px, 28px 28px, cover;
    }
    .map-empty {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      padding: 18px;
      color: #64748b;
      text-align: center;
      font-size: 13px;
    }
    .map-marker {
      position: absolute;
      width: 26px;
      height: 26px;
      transform: translate(-50%, -50%);
      border: 3px solid #fff;
      border-radius: 50%;
      background: #667eea;
      box-shadow: 0 8px 18px rgba(15, 23, 42, .25);
      cursor: pointer;
    }
    .map-marker[data-group="stay"] { background: #2563eb; }
    .map-marker[data-group="eat"] { background: #dc2626; }
    .map-marker[data-group="see"] { background: #15803d; }
    .map-marker.active {
      width: 32px;
      height: 32px;
      z-index: 3;
      box-shadow: 0 0 0 4px rgba(255,255,255,.72), 0 10px 22px rgba(15, 23, 42, .32);
    }
    .map-marker.hidden { display: none; }
    .results-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .result-card {
      background: white;
      border-radius: 12px;
      padding: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      cursor: pointer;
      transition: transform 0.15s, box-shadow 0.15s;
      text-decoration: none;
      color: inherit;
      display: flex;
      gap: 12px;
    }
    .result-card.hidden { display: none; }
    .result-card.selected {
      outline: 2px solid #667eea;
      box-shadow: 0 0 0 4px rgba(102, 126, 234, .12);
    }
    .result-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 16px rgba(0,0,0,0.15);
    }
    .result-card:active {
      transform: translateY(0);
    }
    .card-thumb {
      width: 80px;
      height: 80px;
      border-radius: 8px;
      object-fit: cover;
      flex-shrink: 0;
    }
    .card-content {
      flex: 1;
      min-width: 0;
    }
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 4px;
    }
    .card-title {
      font-size: 16px;
      font-weight: 600;
      color: #333;
    }
    .card-type {
      font-size: 12px;
      color: #667eea;
      background: rgba(102, 126, 234, 0.1);
      padding: 2px 8px;
      border-radius: 12px;
      text-transform: capitalize;
    }
    .card-meta {
      display: flex;
      gap: 16px;
      font-size: 13px;
      color: #666;
      margin-top: 8px;
    }
    .rating {
      color: #f5a623;
    }
    .distance {
      color: #888;
    }
    .card-address {
      font-size: 13px;
      color: #888;
      margin-top: 4px;
    }
    .card-cuisine {
      font-size: 12px;
      color: #667eea;
      margin-top: 6px;
    }
    .photo-gallery {
      display: flex;
      gap: 6px;
      margin-top: 8px;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .photo-gallery::-webkit-scrollbar { display: none; }
    .photo-gallery img {
      width: 52px;
      height: 40px;
      border: 1px solid #e5e7eb;
      border-radius: 6px;
      object-fit: cover;
      flex: 0 0 auto;
    }
    .empty-state {
      text-align: center;
      padding: 40px 20px;
      color: #888;
    }
    .empty-state h2 {
      font-size: 18px;
      margin-bottom: 8px;
    }
    .loading {
      text-align: center;
      padding: 40px 20px;
      color: #888;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1 id="title">{{title}}</h1>
    <div class="count" id="count">{{count}} results found</div>
  </div>
  <div class="toolbar" role="toolbar" aria-label="Result filters">
    <button class="filter-chip active" data-filter="all">All</button>
    <button class="filter-chip" data-filter="stay">Stay</button>
    <button class="filter-chip" data-filter="eat">Eat</button>
    <button class="filter-chip" data-filter="see">See</button>
  </div>
  <div class="map-panel" id="result-map" aria-label="Result map">
    <div class="map-empty">Map markers appear when results include coordinates.</div>
  </div>

  <div id="results-container">
    {{!-- Server-side rendered results (fallback) --}}
    {{#if results}}
    <div class="results-list">
      {{#each results}}
      <a class="result-card" href="{{resource_uri}}" data-osm-id="{{osm_id}}" data-poi-type="{{poi_type}}" data-lat="{{or latitude osm_latitude}}" data-lng="{{or longitude osm_longitude}}" data-resource-uri="{{resource_uri}}" data-preview-url="{{preview_url}}">
        {{#if photo_url}}
        <img class="card-thumb" src="{{photo_url}}" alt="">
        {{/if}}
        <div class="card-content">
          <div class="card-header">
            <span class="card-title">{{or name osm_name "Unknown"}}</span>
            <span class="card-type">{{poi_type}}</span>
          </div>
          {{#if (or google_rating osm_stars distance_km stay_quality_score)}}
          <div class="card-meta">
            {{#if stay_quality_score}}
            <span class="rating">Stay {{stay_quality_score}}/100</span>
            {{/if}}
            {{#if google_rating}}
            <span class="rating">&#11088; {{google_rating}}{{#if google_review_count}} ({{google_review_count}}){{/if}}</span>
            {{else}}
            {{#if osm_stars}}
            <span class="rating">{{osm_stars}} stars</span>
            {{/if}}
            {{/if}}
            {{#if distance_km}}
            <span class="distance">{{formatDistance distance_km}} km</span>
            {{/if}}
          </div>
          {{/if}}
          {{#if (or osm_city osm_country_code)}}
          <div class="card-address">{{osm_city}}{{#if osm_country_code}}, {{osm_country_code}}{{/if}}</div>
          {{/if}}
          {{#if osm_cuisine}}
          <div class="card-cuisine">{{osm_cuisine}}</div>
          {{/if}}
          {{#if google_photos}}
          <div class="photo-gallery" aria-label="Place photos">
            {{#each google_photos}}
            {{#if url}}<img src="{{url}}" alt="" loading="lazy">{{/if}}
            {{/each}}
          </div>
          {{/if}}
        </div>
      </a>
      {{/each}}
    </div>
    {{else}}
    <div class="loading" id="loading">Loading results...</div>
    {{/if}}
  </div>

  <script>
    /**
     * ChatGPT Skybridge Integration for Search Results
     *
     * This template supports two rendering modes:
     *
     * 1. Server-side (Handlebars): Results pre-rendered when loaded via MCP ReadResource
     * 2. Client-side (Skybridge): Results rendered dynamically from window.openai.toolOutput
     *
     * When running in ChatGPT:
     * - window.openai.toolOutput contains the structured search results
     * - window.openai.readResource(uri) requests a POI detail page
     */

    // Format distance to 1 decimal place
    function formatDistance(km) {
      if (km == null) return '';
      var num = parseFloat(km);
      if (isNaN(num)) return km;
      return num.toFixed(1);
    }

    // Render a single result card
    function renderCard(poi) {
      var name = poi.name || poi.osm_name || 'Unknown';
      var rating = '';
      if (poi.google_rating) {
        rating = '<span class="rating">&#11088; ' + escapeHtml(String(poi.google_rating));
        if (poi.google_review_count) {
          rating += ' (' + escapeHtml(String(poi.google_review_count)) + ')';
        }
        rating += '</span>';
      } else if (poi.osm_stars) {
        rating = '<span class="rating">' + escapeHtml(String(poi.osm_stars)) + ' stars</span>';
      }

      var distance = '';
      if (poi.distance_km) {
        distance = '<span class="distance">' + escapeHtml(formatDistance(poi.distance_km)) + ' km</span>';
      }

      var stayQuality = '';
      if (poi.stay_quality_score != null) {
        stayQuality = '<span class="rating">Stay ' + escapeHtml(String(poi.stay_quality_score)) + '/100</span>';
      }

      var address = '';
      if (poi.osm_city || poi.osm_country_code) {
        address = '<div class="card-address">' + escapeHtml(poi.osm_city || '') + (poi.osm_country_code ? ', ' + escapeHtml(poi.osm_country_code) : '') + '</div>';
      }

      var cuisine = '';
      if (poi.osm_cuisine) {
        cuisine = '<div class="card-cuisine">' + escapeHtml(poi.osm_cuisine) + '</div>';
      }

      var photoUrls = getPhotoUrls(poi);
      var photoUrl = photoUrls[0] || '';
      var gallery = photoUrls.length > 1
        ? '<div class="photo-gallery" aria-label="Place photos">' + photoUrls.slice(0, 5).map(function(url) {
            return '<img src="' + escapeHtml(url) + '" alt="" loading="lazy">';
          }).join('') + '</div>'
        : '';

      var card = document.createElement('a');
      card.className = 'result-card';
      card.href = poi.resource_uri || '#';
      card.setAttribute('data-osm-id', poi.osm_id);
      card.setAttribute('data-poi-type', poi.poi_type || '');
      card.setAttribute('data-lat', poi.latitude || poi.osm_latitude || '');
      card.setAttribute('data-lng', poi.longitude || poi.osm_longitude || '');
      card.setAttribute('data-resource-uri', poi.resource_uri || '');
      card.setAttribute('data-preview-url', poi.preview_url || '');

      var thumbHtml = photoUrl ? '<img class="card-thumb" src="' + escapeHtml(photoUrl) + '" alt="">' : '';

      card.innerHTML =
        thumbHtml +
        '<div class="card-content">' +
          '<div class="card-header">' +
            '<span class="card-title">' + escapeHtml(name) + '</span>' +
            '<span class="card-type">' + escapeHtml(poi.poi_type || '') + '</span>' +
          '</div>' +
          (stayQuality || rating || distance ? '<div class="card-meta">' + stayQuality + rating + distance + '</div>' : '') +
          address +
          cuisine +
          gallery +
        '</div>';

      return card;
    }

    function getPhotoUrls(poi) {
      var urls = [];
      if (poi.photo_url) urls.push(poi.photo_url);
      if (Array.isArray(poi.photo_urls)) {
        urls = urls.concat(poi.photo_urls);
      }
      if (Array.isArray(poi.google_photos)) {
        urls = urls.concat(poi.google_photos.map(function(photo) {
          return photo && (photo.url || photo.url_thumbnail);
        }));
      }
      return urls.filter(Boolean).filter(function(url, index, arr) {
        return arr.indexOf(url) === index;
      });
    }

    // Escape HTML to prevent XSS
    function escapeHtml(text) {
      var div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    function typeGroup(type) {
      if (['hotel', 'hostel', 'guest_house', 'motel', 'resort', 'apartment', 'camp_site', 'chalet', 'bed_and_breakfast'].indexOf(type) >= 0) return 'stay';
      if (['restaurant', 'cafe', 'bar', 'pub', 'fast_food', 'food_court'].indexOf(type) >= 0) return 'eat';
      if (['attraction', 'monument', 'museum', 'park', 'viewpoint', 'ruins', 'castle', 'zoo', 'theme_park', 'gallery', 'artwork'].indexOf(type) >= 0) return 'see';
      return 'other';
    }

    function cardData(card) {
      return {
        osm_id: card.getAttribute('data-osm-id'),
        poi_type: card.getAttribute('data-poi-type') || '',
        latitude: parseFloat(card.getAttribute('data-lat')),
        longitude: parseFloat(card.getAttribute('data-lng')),
      };
    }

    function buildMapFromCards() {
      var cards = Array.prototype.slice.call(document.querySelectorAll('.result-card'));
      buildMap(cards.map(cardData).filter(function(poi) {
        return !isNaN(poi.latitude) && !isNaN(poi.longitude);
      }));
    }

    function buildMap(results) {
      var map = document.getElementById('result-map');
      if (!map) return;
      map.innerHTML = '';
      var mapped = (results || []).map(function(poi) {
        return {
          osm_id: String(poi.osm_id || ''),
          poi_type: poi.poi_type || '',
          latitude: parseFloat(poi.latitude || poi.osm_latitude),
          longitude: parseFloat(poi.longitude || poi.osm_longitude),
        };
      }).filter(function(poi) {
        return poi.osm_id && !isNaN(poi.latitude) && !isNaN(poi.longitude);
      });

      if (mapped.length === 0) {
        map.innerHTML = '<div class="map-empty">Map markers appear when results include coordinates.</div>';
        return;
      }

      var lats = mapped.map(function(poi) { return poi.latitude; });
      var lngs = mapped.map(function(poi) { return poi.longitude; });
      var minLat = Math.min.apply(null, lats);
      var maxLat = Math.max.apply(null, lats);
      var minLng = Math.min.apply(null, lngs);
      var maxLng = Math.max.apply(null, lngs);
      var latSpan = Math.max(maxLat - minLat, 0.001);
      var lngSpan = Math.max(maxLng - minLng, 0.001);

      mapped.forEach(function(poi) {
        var marker = document.createElement('button');
        marker.type = 'button';
        marker.className = 'map-marker';
        marker.setAttribute('data-osm-id', poi.osm_id);
        marker.setAttribute('data-group', typeGroup(poi.poi_type));
        marker.setAttribute('aria-label', 'Focus result ' + poi.osm_id);
        marker.style.left = (8 + ((poi.longitude - minLng) / lngSpan) * 84) + '%';
        marker.style.top = (92 - ((poi.latitude - minLat) / latSpan) * 84) + '%';
        marker.addEventListener('click', function() {
          selectResult(poi.osm_id);
        });
        map.appendChild(marker);
      });
    }

    function selectResult(osmId) {
      document.querySelectorAll('.result-card, .map-marker').forEach(function(el) {
        el.classList.toggle('selected', el.getAttribute('data-osm-id') === String(osmId));
        el.classList.toggle('active', el.getAttribute('data-osm-id') === String(osmId));
      });
      var card = Array.prototype.slice.call(document.querySelectorAll('.result-card')).find(function(item) {
        return item.getAttribute('data-osm-id') === String(osmId);
      });
      if (card) card.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }

    function applyFilter(filter) {
      document.querySelectorAll('.filter-chip').forEach(function(button) {
        button.classList.toggle('active', button.getAttribute('data-filter') === filter);
      });
      document.querySelectorAll('.result-card, .map-marker').forEach(function(el) {
        var group = typeGroup(el.getAttribute('data-poi-type') || el.getAttribute('data-group') || '');
        var visible = filter === 'all' || group === filter || el.getAttribute('data-group') === filter;
        el.classList.toggle('hidden', !visible);
      });
    }

    function initFilters() {
      document.querySelectorAll('.filter-chip').forEach(function(button) {
        button.addEventListener('click', function() {
          applyFilter(button.getAttribute('data-filter') || 'all');
        });
      });
    }

    // Render all results
    function renderResults(data) {
      var container = document.getElementById('results-container');
      var title = document.getElementById('title');
      var count = document.getElementById('count');

      // Handle different data formats (array or object with results property)
      var results = Array.isArray(data) ? data : (data.results || data);
      if (!Array.isArray(results)) {
        results = [];
      }

      // Update header
      if (data.title) {
        title.textContent = data.title;
      } else if (results.length > 0 && results[0].poi_type) {
        // Infer title from first result type
        var type = results[0].poi_type;
        title.textContent = type.charAt(0).toUpperCase() + type.slice(1) + 's';
      }
      count.textContent = results.length + ' results found';

      // Clear and render
      container.innerHTML = '';
      if (results.length === 0) {
        container.innerHTML = '<div class="empty-state"><h2>No results found</h2><p>Try adjusting your search criteria</p></div>';
        return;
      }

      var list = document.createElement('div');
      list.className = 'results-list';

      results.forEach(function(poi) {
        var card = renderCard(poi);
        list.appendChild(card);
      });

      container.appendChild(list);

      buildMap(results);
      attachCardHandlers();
      initFilters();
    }

    // Attach click handlers to cards
    function attachCardHandlers() {
      document.querySelectorAll('.result-card').forEach(function(card) {
        card.addEventListener('click', function(e) {
          e.preventDefault();
          var resourceUri = this.getAttribute('data-resource-uri');
          var previewUrl = this.getAttribute('data-preview-url');
          var osmId = this.getAttribute('data-osm-id');

          console.log('Card clicked:', { osmId: osmId, resourceUri: resourceUri, previewUrl: previewUrl });

          // If OpenAI bridge is available, request the POI detail resource
          if (window.openai && window.openai.readResource) {
            window.openai.readResource(resourceUri);
          } else if (previewUrl) {
            // Fallback: open preview URL in new tab
            window.open(previewUrl, '_blank');
          }
        });
        card.addEventListener('mouseenter', function() {
          selectResult(this.getAttribute('data-osm-id'));
        });
      });
    }

    // Initialize
    document.addEventListener('DOMContentLoaded', function() {
      // Check for OpenAI bridge and tool output
      if (window.openai && window.openai.toolOutput) {
        console.log('OpenAI bridge connected, rendering from toolOutput');
        renderResults(window.openai.toolOutput);
      } else {
        // Server-side rendered - just attach handlers
        console.log('No OpenAI bridge, using server-rendered content');
        var loading = document.getElementById('loading');
        if (loading) {
          loading.style.display = 'none';
        }
        attachCardHandlers();
        initFilters();
        buildMapFromCards();
      }
    });
  </script>
</body>
</html>
