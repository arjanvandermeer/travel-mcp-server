<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" href="/favicon.png" type="image/png">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f5f5f5;
      color: #333;
      line-height: 1.5;
      max-width: 430px;
      margin: 0 auto;
    }
    /* Carousel (shared by photos and reviews) */
    .carousel { position: relative; overflow: hidden; }
    .carousel-track {
      display: flex;
      transition: transform 0.3s ease;
      touch-action: pan-y;
    }
    .carousel-arrow {
      position: absolute; top: 50%; transform: translateY(-50%);
      width: 32px; height: 32px; border-radius: 50%;
      background: rgba(255,255,255,0.85); border: 1px solid #ddd;
      box-shadow: 0 2px 6px rgba(0,0,0,0.15);
      font-size: 16px; cursor: pointer; z-index: 2;
      display: flex; align-items: center; justify-content: center;
      color: #333; transition: opacity 0.2s, background 0.15s;
    }
    .carousel-arrow:hover { background: white; }
    .carousel-arrow.hidden { opacity: 0; pointer-events: none; }
    .carousel-arrow-left { left: 8px; }
    .carousel-arrow-right { right: 8px; }
    /* Photo carousel */
    .photo-carousel .carousel-track img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      flex: 0 0 100%;
    }
    .hero-image {
      width: 100%;
      height: 220px;
      object-fit: cover;
    }
    .header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 24px;
    }
    .header h1 { font-size: 24px; margin-bottom: 8px; }
    .header .type-row { display: flex; align-items: center; gap: 12px; margin-bottom: 4px; }
    .header .type { opacity: 0.9; font-size: 14px; text-transform: capitalize; }
    .header .stars { font-size: 14px; }
    .header .brand { opacity: 0.8; font-size: 13px; margin-top: 4px; }
    .header .rating { margin-top: 12px; font-size: 18px; }
    .header .price-level { opacity: 0.9; font-size: 14px; margin-left: 8px; }
    .status-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
      margin-top: 8px;
    }
    .status-open { background: rgba(76, 175, 80, 0.9); }
    .status-closed { background: rgba(244, 67, 54, 0.9); }
    .status-temp-closed { background: rgba(255, 152, 0, 0.9); }
    /* Open/closed badge with hover hours */
    .open-status {
      position: relative;
      display: inline-block;
      margin-top: 8px;
    }
    .open-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
      cursor: default;
    }
    .open-badge.is-open { background: rgba(76, 175, 80, 0.9); }
    .open-badge.is-closed { background: rgba(244, 67, 54, 0.85); }
    .hours-tooltip {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      margin-top: 6px;
      background: white;
      color: #333;
      border-radius: 10px;
      padding: 12px 14px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.15);
      min-width: 220px;
      z-index: 10;
      font-size: 13px;
    }
    .open-status:hover .hours-tooltip,
    .open-status:focus-within .hours-tooltip { display: block; }
    .hours-tooltip ul { list-style: none; }
    .hours-tooltip li { padding: 3px 0; border-bottom: 1px solid #f0f0f0; }
    .hours-tooltip li:last-child { border-bottom: none; }
    .content { padding: 20px; }
    .card {
      background: white;
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 16px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .card h2 { font-size: 14px; color: #666; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px; }
    .card p { font-size: 16px; }
    .card a { color: #667eea; text-decoration: none; }
    .card a:hover { text-decoration: underline; }
    .description { font-size: 15px; line-height: 1.6; color: #444; }
    .address-line { display: block; }
    .contact-row { margin-top: 12px; padding-top: 12px; border-top: 1px solid #eee; }
    .contact-row a { display: block; margin-bottom: 6px; }
    .contact-row a:last-child { margin-bottom: 0; }
    .action-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 12px;
    }
    .action-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      background: #f0f0f0;
      border-radius: 20px;
      color: #333;
      text-decoration: none;
      font-size: 13px;
      font-weight: 500;
      transition: background 0.2s;
    }
    .action-btn:hover { background: #e0e0e0; text-decoration: none; }
    .action-btn svg { width: 16px; height: 16px; flex-shrink: 0; }
    .tags { display: flex; flex-wrap: wrap; gap: 8px; }
    .tag {
      background: #f0f0f0;
      padding: 4px 12px;
      border-radius: 16px;
      font-size: 14px;
      text-transform: capitalize;
    }
    .info-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .info-item { font-size: 14px; }
    .info-item .label { color: #666; font-size: 12px; display: block; }
    .info-item .value { font-weight: 500; }
    .amenities-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
    .amenity {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
    }
    .amenity .icon { font-size: 16px; }
    /* Review carousel */
    .review-carousel .carousel-track { gap: 0; }
    .review-card {
      flex: 0 0 100%;
      padding: 12px 4px;
    }
    .review-inner {
      border-left: 3px solid #667eea;
      padding: 12px;
      background: #fafafa;
      border-radius: 0 8px 8px 0;
    }
    .review-author { font-weight: 600; font-size: 14px; }
    .review-rating { color: #f5a623; font-size: 13px; margin: 4px 0; }
    .review-text { font-size: 14px; color: #555; line-height: 1.5; }
    .review-date { font-size: 12px; color: #999; margin-top: 4px; }
    .favorite-banner {
      background: linear-gradient(135deg, #fff8e1 0%, #ffecb3 100%);
      border-left: 4px solid #f5a623;
      padding: 14px 16px;
      margin-bottom: 16px;
      border-radius: 0 12px 12px 0;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .favorite-banner .favorite-title {
      font-weight: 700;
      font-size: 15px;
      color: #b8860b;
    }
    .favorite-banner .favorite-date {
      font-size: 13px;
      color: #8d6e00;
      margin-top: 4px;
    }
    .favorite-banner .favorite-notes {
      font-size: 14px;
      color: #555;
      margin-top: 8px;
      font-style: italic;
      line-height: 1.5;
    }
    /* Nearby section */
    .nearby-section h2 { font-size: 14px; color: #666; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; }
    .nearby-scroll {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding: 4px 0 12px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .nearby-scroll::-webkit-scrollbar { display: none; }
    .nearby-card {
      flex: 0 0 150px;
      scroll-snap-align: start;
      background: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      text-decoration: none;
      color: inherit;
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .nearby-card:hover { transform: translateY(-2px); box-shadow: 0 4px 16px rgba(0,0,0,0.15); }
    .nearby-card:active { transform: translateY(0); }
    .nearby-thumb { width: 100%; height: 100px; object-fit: cover; display: block; }
    .nearby-thumb-placeholder { width: 100%; height: 100px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center; font-size: 28px; }
    .nearby-info { padding: 8px 10px 10px; }
    .nearby-name { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .nearby-fav { color: #e74c3c; font-size: 11px; }
    .nearby-rating { font-size: 12px; color: #f5a623; margin-top: 2px; }
    .nearby-distance { font-size: 11px; color: #888; margin-top: 2px; }
    .nearby-type { font-size: 10px; color: #667eea; text-transform: capitalize; margin-top: 2px; }
    .scroll-wrapper { position: relative; }
    .scroll-arrow {
      position: absolute; top: 50%; transform: translateY(-50%);
      width: 32px; height: 32px; border-radius: 50%;
      background: white; border: 1px solid #ddd;
      box-shadow: 0 2px 6px rgba(0,0,0,0.15);
      font-size: 16px; cursor: pointer; z-index: 2;
      display: flex; align-items: center; justify-content: center;
      color: #333; transition: opacity 0.2s, background 0.15s;
    }
    .scroll-arrow:hover { background: #f0f0f0; }
    .scroll-arrow.hidden { opacity: 0; pointer-events: none; }
    .scroll-arrow-left { left: -4px; }
    .scroll-arrow-right { right: -4px; }
  </style>
</head>
<body>
  {{#if photo_urls}}
  <div class="carousel photo-carousel" data-carousel data-auto="5000">
    {{#if (gt photo_urls.length 1)}}
    <button class="carousel-arrow carousel-arrow-left hidden" data-dir="prev">&#8249;</button>
    {{/if}}
    <div class="carousel-track">
      {{#each photo_urls}}
      <img src="{{this}}" alt="Photo {{@index}}">
      {{/each}}
    </div>
    {{#if (gt photo_urls.length 1)}}
    <button class="carousel-arrow carousel-arrow-right" data-dir="next">&#8250;</button>
    {{/if}}
  </div>
  {{else}}
  {{#if photo_url}}
  <img class="hero-image" src="{{photo_url}}" alt="{{poiName this}}">
  {{/if}}
  {{/if}}

  <div class="header">
    <div class="type-row">
      <span class="type">{{poi_type}}</span>
      {{#if osm_stars}}
      <span class="stars">{{starDisplay}}</span>
      {{/if}}
    </div>
    <h1>{{poiName this}}</h1>
    {{#if osm_brand}}
    <div class="brand">by {{osm_brand}}</div>
    {{else}}
    {{#if osm_operator}}
    <div class="brand">by {{osm_operator}}</div>
    {{/if}}
    {{/if}}
    {{#if google_rating}}
    <div class="rating">
      {{formatRating google_rating}}
      {{#if google_review_count}}
      ({{google_review_count}} reviews)
      {{/if}}
      {{#if price_display}}
      <span class="price-level">{{price_display}}</span>
      {{/if}}
    </div>
    {{/if}}
    {{#if business_status_display}}
    <span class="status-badge {{business_status_class}}">{{business_status_display}}</span>
    {{/if}}
    {{#if open_status}}
    <div class="open-status" tabindex="0">
      <span class="open-badge {{#if open_status.isOpen}}is-open{{else}}is-closed{{/if}}">{{open_status.label}}</span>
      {{#if opening_hours}}
      <div class="hours-tooltip">
        <ul>
          {{#each opening_hours}}
          <li>{{this}}</li>
          {{/each}}
        </ul>
      </div>
      {{/if}}
    </div>
    {{/if}}
  </div>

  <div class="content">
    {{#if is_favorite}}
    <div class="favorite-banner">
      <div class="favorite-title">⭐ On Your Favorites</div>
      {{#if favorite_since}}
      <div class="favorite-date">Added {{formatDate favorite_since}}</div>
      {{/if}}
      {{#if favorite_notes}}
      <div class="favorite-notes">{{favorite_notes}}</div>
      {{/if}}
    </div>
    {{/if}}

    {{#if google_editorial_summary}}
    <div class="card">
      <h2>About</h2>
      <p class="description">{{google_editorial_summary}}</p>
    </div>
    {{/if}}

    {{#if (or osm_address google_address)}}
    <div class="card">
      <h2>Location & Contact</h2>
      {{#each address_lines}}
      <span class="address-line">{{this}}</span>
      {{/each}}
      <div class="action-buttons">
        <a class="action-btn" href="{{mapsUrl osm_latitude osm_longitude google_place_id}}" target="_blank">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Google Maps
        </a>
        {{#if website_url}}
        <a class="action-btn" href="{{website_url}}" target="_blank">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          Website
        </a>
        {{/if}}
      </div>
      {{#if has_contact}}
      <div class="contact-row">
        {{#if google_phone}}
        <a href="tel:{{google_phone}}">{{google_phone}}</a>
        {{else}}
        {{#if osm_phone}}
        <a href="tel:{{osm_phone}}">{{osm_phone}}</a>
        {{/if}}
        {{/if}}
        {{#if osm_email}}
        <a href="mailto:{{osm_email}}">{{osm_email}}</a>
        {{/if}}
      </div>
      {{/if}}
    </div>
    {{/if}}

    {{#if is_accommodation}}
    {{#if has_hotel_info}}
    <div class="card">
      <h2>Hotel Details</h2>
      <div class="info-grid">
        {{#if stay_quality_score}}
        <div class="info-item">
          <span class="label">Stay Quality</span>
          <span class="value">{{stay_quality_score}}/100</span>
        </div>
        {{/if}}
        {{#if osm_rooms}}
        <div class="info-item">
          <span class="label">Rooms</span>
          <span class="value">{{osm_rooms}}</span>
        </div>
        {{/if}}
        {{#if osm_beds}}
        <div class="info-item">
          <span class="label">Beds</span>
          <span class="value">{{osm_beds}}</span>
        </div>
        {{/if}}
        {{#if osm_stars}}
        <div class="info-item">
          <span class="label">Star Rating</span>
          <span class="value">{{osm_stars}} stars</span>
        </div>
        {{/if}}
      </div>
    </div>
    {{/if}}
    {{/if}}

    {{#if is_food}}
    {{#if cuisine_list}}
    <div class="card">
      <h2>Cuisine</h2>
      <div class="tags">
        {{#each cuisine_list}}
        <span class="tag">{{this}}</span>
        {{/each}}
      </div>
    </div>
    {{/if}}
    {{/if}}

    {{#if service_options_list}}
    <div class="card">
      <h2>Services</h2>
      <div class="tags">
        {{#each service_options_list}}
        <span class="tag">{{this}}</span>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#if amenities_list}}
    <div class="card">
      <h2>Amenities</h2>
      <div class="amenities-grid">
        {{#each amenities_list}}
        <div class="amenity">
          <span class="icon">{{icon}}</span>
          <span>{{name}}</span>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#if accessibility_list}}
    <div class="card">
      <h2>Accessibility</h2>
      <div class="tags">
        {{#each accessibility_list}}
        <span class="tag">{{this}}</span>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#if reviews_list}}
    <div class="card">
      <h2>Reviews</h2>
      <div class="carousel review-carousel" data-carousel>
        {{#if (gt reviews_list.length 1)}}
        <button class="carousel-arrow carousel-arrow-left hidden" data-dir="prev">&#8249;</button>
        {{/if}}
        <div class="carousel-track">
          {{#each reviews_list}}
          <div class="review-card">
            <div class="review-inner">
              <div class="review-author">{{author}}</div>
              <div class="review-rating">{{ratingStars}}</div>
              <p class="review-text">{{text}}</p>
              {{#if relativeTime}}
              <div class="review-date">{{relativeTime}}</div>
              {{/if}}
            </div>
          </div>
          {{/each}}
        </div>
        {{#if (gt reviews_list.length 1)}}
        <button class="carousel-arrow carousel-arrow-right" data-dir="next">&#8250;</button>
        {{/if}}
      </div>
    </div>
    {{/if}}

    {{#if nearby_pois}}
    <div class="card nearby-section">
      <h2>{{nearby_title}}</h2>
      <div class="scroll-wrapper">
        <button class="scroll-arrow scroll-arrow-left hidden">&#8249;</button>
        <div class="nearby-scroll">
          {{#each nearby_pois}}
          <a class="nearby-card" href="{{preview_url}}" data-osm-id="{{osm_id}}" data-resource-uri="{{resource_uri}}" data-preview-url="{{preview_url}}">
            {{#if photo_url}}
            <img class="nearby-thumb" src="{{photo_url}}" alt="" loading="lazy">
            {{else}}
            <div class="nearby-thumb-placeholder">
              {{#ifEq poi_type "restaurant"}}&#127869;{{else}}{{#ifEq poi_type "cafe"}}&#9749;{{else}}{{#ifEq poi_type "hotel"}}&#127976;{{else}}&#128205;{{/ifEq}}{{/ifEq}}{{/ifEq}}
            </div>
            {{/if}}
            <div class="nearby-info">
              <div class="nearby-name">{{#if is_favorite}}<span class="nearby-fav">&#9829;</span> {{/if}}{{or name "Unknown"}}</div>
              {{#if google_rating}}
              <div class="nearby-rating">&#11088; {{google_rating}}</div>
              {{/if}}
              {{#if distance_km}}
              <div class="nearby-distance">{{formatDistance distance_km}} km away</div>
              {{/if}}
              <div class="nearby-type">{{poi_type}}</div>
            </div>
          </a>
          {{/each}}
        </div>
        <button class="scroll-arrow scroll-arrow-right">&#8250;</button>
      </div>
    </div>
    {{/if}}
  </div>

  <script>
    (function() {
      function initCarousels() {
        document.querySelectorAll('[data-carousel]').forEach(function(carousel) {
          var track = carousel.querySelector('.carousel-track');
          var leftBtn = carousel.querySelector('.carousel-arrow-left');
          var rightBtn = carousel.querySelector('.carousel-arrow-right');
          var count = track.children.length;
          if (count < 1) return;
          var current = 0, startX = 0, deltaX = 0, autoInterval = null;
          var autoDelay = parseInt(carousel.dataset.auto, 10) || 0;

          function updateArrows() {
            if (leftBtn) leftBtn.classList.toggle('hidden', current <= 0);
            if (rightBtn) rightBtn.classList.toggle('hidden', current >= count - 1);
          }
          function goTo(index) {
            current = Math.max(0, Math.min(index, count - 1));
            track.style.transform = 'translateX(-' + (current * 100) + '%)';
            updateArrows();
          }
          function next() { goTo((current + 1) % count); }
          function startAuto() { if (autoDelay > 0 && count > 1) autoInterval = setInterval(next, autoDelay); }
          function stopAuto() { if (autoInterval) { clearInterval(autoInterval); autoInterval = null; } }

          startAuto();
          updateArrows();

          if (leftBtn) leftBtn.addEventListener('click', function() { stopAuto(); goTo(current - 1); startAuto(); });
          if (rightBtn) rightBtn.addEventListener('click', function() { stopAuto(); goTo(current + 1); startAuto(); });
          track.addEventListener('touchstart', function(e) {
            stopAuto(); startX = e.touches[0].clientX; deltaX = 0; track.style.transition = 'none';
          }, { passive: true });
          track.addEventListener('touchmove', function(e) {
            deltaX = e.touches[0].clientX - startX;
            track.style.transform = 'translateX(' + (-(current * 100) + (deltaX / track.offsetWidth * 100)) + '%)';
          }, { passive: true });
          track.addEventListener('touchend', function() {
            track.style.transition = 'transform 0.3s ease';
            goTo(current + (Math.abs(deltaX) > 50 ? (deltaX < 0 ? 1 : -1) : 0));
            startAuto();
          });
        });
      }

      // Boot: detect widget mode (ChatGPT Skybridge) vs server-side rendered
      function boot() {
        var output = window.openai && window.openai.toolOutput;
        if (output && output._html) {
          // Widget mode: use pre-rendered HTML from server
          var doc = new DOMParser().parseFromString(output._html, 'text/html');
          document.body.innerHTML = doc.body.innerHTML;
        }
        initCarousels();
        // Nearby scroll arrows
        document.querySelectorAll('.scroll-wrapper').forEach(function(wrapper) {
          var scrollEl = wrapper.querySelector('.nearby-scroll');
          var leftBtn = wrapper.querySelector('.scroll-arrow-left');
          var rightBtn = wrapper.querySelector('.scroll-arrow-right');
          if (!scrollEl || !leftBtn || !rightBtn) return;
          function updateArrows() {
            leftBtn.classList.toggle('hidden', scrollEl.scrollLeft <= 0);
            rightBtn.classList.toggle('hidden', scrollEl.scrollLeft + scrollEl.clientWidth >= scrollEl.scrollWidth - 1);
          }
          leftBtn.addEventListener('click', function() { scrollEl.scrollBy({ left: -324, behavior: 'smooth' }); });
          rightBtn.addEventListener('click', function() { scrollEl.scrollBy({ left: 324, behavior: 'smooth' }); });
          scrollEl.addEventListener('scroll', updateArrows);
          updateArrows();
        });
        // Nearby card click handlers
        document.querySelectorAll('.nearby-card').forEach(function(card) {
          card.addEventListener('click', function(e) {
            e.preventDefault();
            var resourceUri = this.getAttribute('data-resource-uri');
            var previewUrl = this.getAttribute('data-preview-url');
            if (window.openai && window.openai.readResource) {
              window.openai.readResource(resourceUri);
            } else if (previewUrl) {
              // If inside an iframe (SPA), navigate the parent page so its state updates
              var osmIdMatch = previewUrl.match(/\/preview\/poi\/(\d+)/);
              if (window.parent !== window && osmIdMatch) {
                window.parent.location.href = '/poi/' + osmIdMatch[1];
              } else {
                window.location.href = previewUrl;
              }
            }
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
      } else {
        boot();
      }
    })();
  </script>
</body>
</html>
