<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f5f5f5;
      color: #333;
      line-height: 1.5;
      max-width: 430px;
      margin: 0 auto;
    }
    /* Carousel (shared by photos and reviews) */
    .carousel { position: relative; overflow: hidden; }
    .carousel-track {
      display: flex;
      transition: transform 0.3s ease;
      touch-action: pan-y;
    }
    .carousel-dots {
      display: flex;
      justify-content: center;
      gap: 6px;
      padding: 10px 0 4px;
    }
    .carousel-dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: #ccc;
      border: none;
      padding: 0;
      cursor: pointer;
      transition: background 0.2s;
    }
    .carousel-dot.active { background: #667eea; }
    /* Photo carousel */
    .photo-carousel .carousel-track img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      flex: 0 0 100%;
    }
    .photo-carousel .carousel-dots {
      position: absolute;
      bottom: 8px;
      left: 0; right: 0;
    }
    .photo-carousel .carousel-dot { background: rgba(255,255,255,0.5); }
    .photo-carousel .carousel-dot.active { background: white; }
    .hero-image {
      width: 100%;
      height: 220px;
      object-fit: cover;
    }
    .header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 24px;
    }
    .header h1 { font-size: 24px; margin-bottom: 8px; }
    .header .type-row { display: flex; align-items: center; gap: 12px; margin-bottom: 4px; }
    .header .type { opacity: 0.9; font-size: 14px; text-transform: capitalize; }
    .header .stars { font-size: 14px; }
    .header .brand { opacity: 0.8; font-size: 13px; margin-top: 4px; }
    .header .rating { margin-top: 12px; font-size: 18px; }
    .header .price-level { opacity: 0.9; font-size: 14px; margin-left: 8px; }
    .status-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
      margin-top: 8px;
    }
    .status-open { background: rgba(76, 175, 80, 0.9); }
    .status-closed { background: rgba(244, 67, 54, 0.9); }
    .status-temp-closed { background: rgba(255, 152, 0, 0.9); }
    /* Open/closed badge with hover hours */
    .open-status {
      position: relative;
      display: inline-block;
      margin-top: 8px;
    }
    .open-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
      cursor: default;
    }
    .open-badge.is-open { background: rgba(76, 175, 80, 0.9); }
    .open-badge.is-closed { background: rgba(244, 67, 54, 0.85); }
    .hours-tooltip {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      margin-top: 6px;
      background: white;
      color: #333;
      border-radius: 10px;
      padding: 12px 14px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.15);
      min-width: 220px;
      z-index: 10;
      font-size: 13px;
    }
    .open-status:hover .hours-tooltip,
    .open-status:focus-within .hours-tooltip { display: block; }
    .hours-tooltip ul { list-style: none; }
    .hours-tooltip li { padding: 3px 0; border-bottom: 1px solid #f0f0f0; }
    .hours-tooltip li:last-child { border-bottom: none; }
    .content { padding: 20px; }
    .card {
      background: white;
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 16px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .card h2 { font-size: 14px; color: #666; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px; }
    .card p { font-size: 16px; }
    .card a { color: #667eea; text-decoration: none; }
    .card a:hover { text-decoration: underline; }
    .description { font-size: 15px; line-height: 1.6; color: #444; }
    .address-line { display: block; }
    .contact-row { margin-top: 12px; padding-top: 12px; border-top: 1px solid #eee; }
    .contact-row a { display: block; margin-bottom: 6px; }
    .contact-row a:last-child { margin-bottom: 0; }
    .action-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 12px;
    }
    .action-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 14px;
      background: #f0f0f0;
      border-radius: 20px;
      color: #333;
      text-decoration: none;
      font-size: 13px;
      font-weight: 500;
      transition: background 0.2s;
    }
    .action-btn:hover { background: #e0e0e0; text-decoration: none; }
    .action-btn svg { width: 16px; height: 16px; flex-shrink: 0; }
    .tags { display: flex; flex-wrap: wrap; gap: 8px; }
    .tag {
      background: #f0f0f0;
      padding: 4px 12px;
      border-radius: 16px;
      font-size: 14px;
      text-transform: capitalize;
    }
    .info-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
    .info-item { font-size: 14px; }
    .info-item .label { color: #666; font-size: 12px; display: block; }
    .info-item .value { font-weight: 500; }
    .amenities-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
    .amenity {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
    }
    .amenity .icon { font-size: 16px; }
    /* Review carousel */
    .review-carousel .carousel-track { gap: 0; }
    .review-card {
      flex: 0 0 100%;
      padding: 12px 4px;
    }
    .review-inner {
      border-left: 3px solid #667eea;
      padding: 12px;
      background: #fafafa;
      border-radius: 0 8px 8px 0;
    }
    .review-author { font-weight: 600; font-size: 14px; }
    .review-rating { color: #f5a623; font-size: 13px; margin: 4px 0; }
    .review-text { font-size: 14px; color: #555; line-height: 1.5; }
    .review-date { font-size: 12px; color: #999; margin-top: 4px; }
    .favorite-banner {
      background: linear-gradient(135deg, #fff8e1 0%, #ffecb3 100%);
      border-left: 4px solid #f5a623;
      padding: 14px 16px;
      margin-bottom: 16px;
      border-radius: 0 12px 12px 0;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .favorite-banner .favorite-title {
      font-weight: 700;
      font-size: 15px;
      color: #b8860b;
    }
    .favorite-banner .favorite-date {
      font-size: 13px;
      color: #8d6e00;
      margin-top: 4px;
    }
    .favorite-banner .favorite-notes {
      font-size: 14px;
      color: #555;
      margin-top: 8px;
      font-style: italic;
      line-height: 1.5;
    }
  </style>
</head>
<body>
  {{#if photo_urls}}
  <div class="carousel photo-carousel" data-carousel data-auto="5000">
    <div class="carousel-track">
      {{#each photo_urls}}
      <img src="{{this}}" alt="Photo {{@index}}">
      {{/each}}
    </div>
    {{#if (gt photo_urls.length 1)}}
    <div class="carousel-dots">
      {{#each photo_urls}}
      <button class="carousel-dot{{#if @first}} active{{/if}}" data-index="{{@index}}"></button>
      {{/each}}
    </div>
    {{/if}}
  </div>
  {{else}}
  {{#if photo_url}}
  <img class="hero-image" src="{{photo_url}}" alt="{{poiName this}}">
  {{/if}}
  {{/if}}

  <div class="header">
    <div class="type-row">
      <span class="type">{{poi_type}}</span>
      {{#if osm_stars}}
      <span class="stars">{{starDisplay}}</span>
      {{/if}}
    </div>
    <h1>{{poiName this}}</h1>
    {{#if osm_brand}}
    <div class="brand">by {{osm_brand}}</div>
    {{else}}
    {{#if osm_operator}}
    <div class="brand">by {{osm_operator}}</div>
    {{/if}}
    {{/if}}
    {{#if google_rating}}
    <div class="rating">
      {{formatRating google_rating}}
      {{#if google_review_count}}
      ({{google_review_count}} reviews)
      {{/if}}
      {{#if price_display}}
      <span class="price-level">{{price_display}}</span>
      {{/if}}
    </div>
    {{/if}}
    {{#if business_status_display}}
    <span class="status-badge {{business_status_class}}">{{business_status_display}}</span>
    {{/if}}
    {{#if open_status}}
    <div class="open-status" tabindex="0">
      <span class="open-badge {{#if open_status.isOpen}}is-open{{else}}is-closed{{/if}}">{{open_status.label}}</span>
      {{#if opening_hours}}
      <div class="hours-tooltip">
        <ul>
          {{#each opening_hours}}
          <li>{{this}}</li>
          {{/each}}
        </ul>
      </div>
      {{/if}}
    </div>
    {{/if}}
  </div>

  <div class="content">
    {{#if is_favorite}}
    <div class="favorite-banner">
      <div class="favorite-title">⭐ On Your Favorites</div>
      {{#if favorite_since}}
      <div class="favorite-date">Added {{formatDate favorite_since}}</div>
      {{/if}}
      {{#if favorite_notes}}
      <div class="favorite-notes">{{favorite_notes}}</div>
      {{/if}}
    </div>
    {{/if}}

    {{#if google_editorial_summary}}
    <div class="card">
      <h2>About</h2>
      <p class="description">{{google_editorial_summary}}</p>
    </div>
    {{/if}}

    {{#if (or osm_address google_address)}}
    <div class="card">
      <h2>Location & Contact</h2>
      {{#each address_lines}}
      <span class="address-line">{{this}}</span>
      {{/each}}
      <div class="action-buttons">
        <a class="action-btn" href="{{mapsUrl osm_latitude osm_longitude google_place_id}}" target="_blank">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Google Maps
        </a>
        {{#if website_url}}
        <a class="action-btn" href="{{website_url}}" target="_blank">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          Website
        </a>
        {{/if}}
      </div>
      {{#if has_contact}}
      <div class="contact-row">
        {{#if google_phone}}
        <a href="tel:{{google_phone}}">{{google_phone}}</a>
        {{else}}
        {{#if osm_phone}}
        <a href="tel:{{osm_phone}}">{{osm_phone}}</a>
        {{/if}}
        {{/if}}
        {{#if osm_email}}
        <a href="mailto:{{osm_email}}">{{osm_email}}</a>
        {{/if}}
      </div>
      {{/if}}
    </div>
    {{/if}}

    {{#if is_accommodation}}
    {{#if has_hotel_info}}
    <div class="card">
      <h2>Hotel Details</h2>
      <div class="info-grid">
        {{#if osm_rooms}}
        <div class="info-item">
          <span class="label">Rooms</span>
          <span class="value">{{osm_rooms}}</span>
        </div>
        {{/if}}
        {{#if osm_beds}}
        <div class="info-item">
          <span class="label">Beds</span>
          <span class="value">{{osm_beds}}</span>
        </div>
        {{/if}}
        {{#if osm_stars}}
        <div class="info-item">
          <span class="label">Star Rating</span>
          <span class="value">{{osm_stars}} stars</span>
        </div>
        {{/if}}
      </div>
    </div>
    {{/if}}
    {{/if}}

    {{#if is_food}}
    {{#if cuisine_list}}
    <div class="card">
      <h2>Cuisine</h2>
      <div class="tags">
        {{#each cuisine_list}}
        <span class="tag">{{this}}</span>
        {{/each}}
      </div>
    </div>
    {{/if}}
    {{/if}}

    {{#if service_options_list}}
    <div class="card">
      <h2>Services</h2>
      <div class="tags">
        {{#each service_options_list}}
        <span class="tag">{{this}}</span>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#if amenities_list}}
    <div class="card">
      <h2>Amenities</h2>
      <div class="amenities-grid">
        {{#each amenities_list}}
        <div class="amenity">
          <span class="icon">{{icon}}</span>
          <span>{{name}}</span>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#if accessibility_list}}
    <div class="card">
      <h2>Accessibility</h2>
      <div class="tags">
        {{#each accessibility_list}}
        <span class="tag">{{this}}</span>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#if reviews_list}}
    <div class="card">
      <h2>Reviews</h2>
      <div class="carousel review-carousel" data-carousel>
        <div class="carousel-track">
          {{#each reviews_list}}
          <div class="review-card">
            <div class="review-inner">
              <div class="review-author">{{author}}</div>
              <div class="review-rating">{{ratingStars}}</div>
              <p class="review-text">{{text}}</p>
              {{#if relativeTime}}
              <div class="review-date">{{relativeTime}}</div>
              {{/if}}
            </div>
          </div>
          {{/each}}
        </div>
        {{#if (gt reviews_list.length 1)}}
        <div class="carousel-dots">
          {{#each reviews_list}}
          <button class="carousel-dot{{#if @first}} active{{/if}}" data-index="{{@index}}"></button>
          {{/each}}
        </div>
        {{/if}}
      </div>
    </div>
    {{/if}}
  </div>

  <script>
    (function() {
      var ACCOMMODATION = ['hotel','hostel','guest_house','motel','resort','apartment','bed_and_breakfast'];
      var FOOD = ['restaurant','cafe','fast_food','bar','pub','food_court','ice_cream','biergarten'];

      function esc(s) {
        if (!s) return '';
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }

      function getName(p) {
        if (p.google_display_name) {
          if (typeof p.google_display_name === 'object') return p.google_display_name.text || p.osm_name || 'Unknown';
          if (typeof p.google_display_name === 'string') {
            try { return JSON.parse(p.google_display_name).text || p.osm_name || 'Unknown'; } catch(e) { return p.google_display_name; }
          }
        }
        return p.osm_name || 'Unknown';
      }

      function fmtDate(d) {
        if (!d) return '';
        var dt = new Date(d);
        return isNaN(dt.getTime()) ? '' : dt.toLocaleDateString('en-US', {year:'numeric',month:'long',day:'numeric'});
      }

      function isOpenNow(hours, offset) {
        if (!hours || !hours.periods || !Array.isArray(hours.periods) || offset == null) return null;
        var now = new Date();
        var utcMs = now.getTime() + now.getTimezoneOffset() * 60000;
        var local = new Date(utcMs + offset * 60000);
        var day = local.getDay(), cur = local.getHours() * 60 + local.getMinutes();
        for (var i = 0; i < hours.periods.length; i++) {
          var p = hours.periods[i];
          if (!p.open) continue;
          var oD = p.open.day, oM = p.open.hour * 60 + p.open.minute;
          if (!p.close) { if (oD === day) return {isOpen:true, label:'Open 24 hours'}; continue; }
          var cD = p.close.day, cM = p.close.hour * 60 + p.close.minute;
          if (oD === cD && oD === day && cur >= oM && cur < cM) return {isOpen:true, label:'Open now'};
          if (oD !== cD && ((day === oD && cur >= oM) || (day === cD && cur < cM))) return {isOpen:true, label:'Open now'};
        }
        return {isOpen:false, label:'Closed'};
      }

      function renderPOI(poi) {
        var name = getName(poi);
        var isAcc = ACCOMMODATION.indexOf(poi.poi_type) >= 0;
        var isFood = FOOD.indexOf(poi.poi_type) >= 0;
        var photos = (poi.google_photos || []).map(function(p){return p.url;}).filter(Boolean);
        var addr = poi.osm_address || poi.google_address || '';
        var addrLines = addr.split(',').map(function(s){return s.trim();}).filter(Boolean);
        var stars = poi.osm_stars ? '\u2605'.repeat(parseInt(poi.osm_stars,10)||0) : '';
        var priceMap = {PRICE_LEVEL_FREE:'Free',PRICE_LEVEL_INEXPENSIVE:'$',PRICE_LEVEL_MODERATE:'$$',PRICE_LEVEL_EXPENSIVE:'$$$',PRICE_LEVEL_VERY_EXPENSIVE:'$$$$'};
        var price = poi.google_price_level ? priceMap[poi.google_price_level]||'' : '';
        var lat = poi.osm_latitude, lon = poi.osm_longitude;
        var mapsUrl = poi.google_place_id
          ? 'https://www.google.com/maps/search/?api=1&query='+lat+','+lon+'&query_place_id='+poi.google_place_id
          : 'https://www.google.com/maps?q='+lat+','+lon;
        var website = poi.google_website || poi.osm_website || null;

        // Open/closed (non-accommodation only)
        var openSt = !isAcc ? isOpenNow(poi.google_opening_hours, poi.google_utc_offset_minutes) : null;
        var weekdays = !isAcc && poi.google_opening_hours ? poi.google_opening_hours.weekdayDescriptions : null;

        // Cuisine
        var cuisines = poi.osm_cuisine ? poi.osm_cuisine.split(/[;,]/).map(function(c){return c.trim().replace(/_/g,' ');}).filter(Boolean) : [];

        // Reviews (handle both DB simplified format and raw Google format)
        var reviews = [];
        if (poi.google_reviews && Array.isArray(poi.google_reviews)) {
          reviews = poi.google_reviews.slice(0,3).map(function(r) {
            var rating = r.rating || 0;
            return {
              author: r.author || (r.authorAttribution && r.authorAttribution.displayName) || 'Anonymous',
              stars: '\u2605'.repeat(rating) + '\u2606'.repeat(5-rating),
              text: typeof r.text === 'string' ? r.text : (r.text && r.text.text) || '',
              time: r.relativeTime || r.relativePublishTimeDescription || null
            };
          }).filter(function(r){return r.text;});
        }

        // Services
        var services = [];
        if (poi.google_service_options) {
          var o = poi.google_service_options;
          if(o.dineIn)services.push('Dine-in'); if(o.takeout)services.push('Takeout');
          if(o.delivery)services.push('Delivery'); if(o.curbsidePickup)services.push('Curbside pickup');
          if(o.servesBreakfast)services.push('Breakfast'); if(o.servesLunch)services.push('Lunch');
          if(o.servesDinner)services.push('Dinner'); if(o.servesBrunch)services.push('Brunch');
          if(o.servesBeer)services.push('Beer'); if(o.servesWine)services.push('Wine');
          if(o.servesCocktails)services.push('Cocktails'); if(o.servesCoffee)services.push('Coffee');
          if(o.servesDessert)services.push('Dessert'); if(o.servesVegetarianFood)services.push('Vegetarian options');
          if(o.outdoorSeating)services.push('Outdoor seating'); if(o.liveMusic)services.push('Live music');
          if(o.reservable)services.push('Reservations');
        }

        // Amenities
        var amenities = [];
        if (poi.google_amenities) {
          var a = poi.google_amenities;
          if(a.restroom)amenities.push({i:'\ud83d\udebb',n:'Restroom'});
          if(a.goodForChildren)amenities.push({i:'\ud83d\udc76',n:'Good for children'});
          if(a.goodForGroups)amenities.push({i:'\ud83d\udc65',n:'Good for groups'});
          if(a.goodForWatchingSports)amenities.push({i:'\ud83d\udcfa',n:'Sports viewing'});
          if(a.menuForChildren)amenities.push({i:'\ud83c\udf7d\ufe0f',n:'Kids menu'});
          if(a.paymentOptions){
            if(a.paymentOptions.acceptsCreditCards)amenities.push({i:'\ud83d\udcb3',n:'Credit cards'});
            if(a.paymentOptions.acceptsCashOnly)amenities.push({i:'\ud83d\udcb5',n:'Cash only'});
          }
          if(a.parkingOptions){
            if(a.parkingOptions.paidParkingLot)amenities.push({i:'\ud83c\udd7f\ufe0f',n:'Paid parking'});
            if(a.parkingOptions.freeParkingLot)amenities.push({i:'\ud83c\udd7f\ufe0f',n:'Free parking'});
            if(a.parkingOptions.streetParking)amenities.push({i:'\ud83d\ude97',n:'Street parking'});
            if(a.parkingOptions.valetParking)amenities.push({i:'\ud83d\udd11',n:'Valet parking'});
          }
        }

        // Accessibility
        var access = [];
        if(poi.osm_wheelchair==='yes')access.push('Wheelchair accessible');
        if(poi.osm_wheelchair==='limited')access.push('Limited wheelchair access');
        if(poi.google_accessibility){
          var ac=poi.google_accessibility;
          if(ac.wheelchairAccessibleEntrance)access.push('Wheelchair entrance');
          if(ac.wheelchairAccessibleRestroom)access.push('Wheelchair restroom');
          if(ac.wheelchairAccessibleSeating)access.push('Wheelchair seating');
          if(ac.wheelchairAccessibleParking)access.push('Wheelchair parking');
        }
        access = access.filter(function(v,i,a){return a.indexOf(v)===i;});

        // SVG icons
        var mapSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>';
        var webSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>';

        var h = '';

        // Photos
        if (photos.length > 1) {
          h += '<div class="carousel photo-carousel" data-carousel data-auto="5000"><div class="carousel-track">';
          photos.forEach(function(u,i){h+='<img src="'+esc(u)+'" alt="Photo '+i+'">';});
          h += '</div><div class="carousel-dots">';
          photos.forEach(function(_,i){h+='<button class="carousel-dot'+(i===0?' active':'')+'" data-index="'+i+'"></button>';});
          h += '</div></div>';
        } else if (photos.length === 1) {
          h += '<img class="hero-image" src="'+esc(photos[0])+'" alt="'+esc(name)+'">';
        }

        // Header
        h += '<div class="header"><div class="type-row"><span class="type">'+esc(poi.poi_type)+'</span>';
        if (stars) h += '<span class="stars">'+stars+'</span>';
        h += '</div><h1>'+esc(name)+'</h1>';
        if (poi.osm_brand) h += '<div class="brand">by '+esc(poi.osm_brand)+'</div>';
        else if (poi.osm_operator) h += '<div class="brand">by '+esc(poi.osm_operator)+'</div>';
        if (poi.google_rating) {
          h += '<div class="rating">\u2b50 '+poi.google_rating;
          if (poi.google_review_count) h += ' ('+poi.google_review_count+' reviews)';
          if (price) h += ' <span class="price-level">'+esc(price)+'</span>';
          h += '</div>';
        }
        if (poi.google_business_status === 'CLOSED_PERMANENTLY')
          h += '<span class="status-badge status-closed">Permanently Closed</span>';
        else if (poi.google_business_status === 'CLOSED_TEMPORARILY')
          h += '<span class="status-badge status-temp-closed">Temporarily Closed</span>';
        if (openSt) {
          h += '<div class="open-status" tabindex="0"><span class="open-badge '+(openSt.isOpen?'is-open':'is-closed')+'">'+esc(openSt.label)+'</span>';
          if (weekdays && weekdays.length) {
            h += '<div class="hours-tooltip"><ul>';
            weekdays.forEach(function(d){h+='<li>'+esc(d)+'</li>';});
            h += '</ul></div>';
          }
          h += '</div>';
        }
        h += '</div>';

        // Content
        h += '<div class="content">';

        // Favorite
        if (poi.is_favorite) {
          h += '<div class="favorite-banner"><div class="favorite-title">\u2b50 On Your Favorites</div>';
          if (poi.favorite_since) h += '<div class="favorite-date">Added '+fmtDate(poi.favorite_since)+'</div>';
          if (poi.favorite_notes) h += '<div class="favorite-notes">'+esc(poi.favorite_notes)+'</div>';
          h += '</div>';
        }

        // About
        if (poi.google_editorial_summary)
          h += '<div class="card"><h2>About</h2><p class="description">'+esc(poi.google_editorial_summary)+'</p></div>';

        // Location & Contact
        if (addr) {
          h += '<div class="card"><h2>Location &amp; Contact</h2>';
          addrLines.forEach(function(l){h+='<span class="address-line">'+esc(l)+'</span>';});
          h += '<div class="action-buttons"><a class="action-btn" href="'+esc(mapsUrl)+'" target="_blank">'+mapSvg+' Google Maps</a>';
          if (website) h += '<a class="action-btn" href="'+esc(website)+'" target="_blank">'+webSvg+' Website</a>';
          h += '</div>';
          var phone = poi.google_phone || poi.osm_phone;
          if (phone || poi.osm_email) {
            h += '<div class="contact-row">';
            if (phone) h += '<a href="tel:'+esc(phone)+'">'+esc(phone)+'</a>';
            if (poi.osm_email) h += '<a href="mailto:'+esc(poi.osm_email)+'">'+esc(poi.osm_email)+'</a>';
            h += '</div>';
          }
          h += '</div>';
        }

        // Hotel details
        if (isAcc && (poi.osm_rooms || poi.osm_beds || poi.osm_stars)) {
          h += '<div class="card"><h2>Hotel Details</h2><div class="info-grid">';
          if (poi.osm_rooms) h += '<div class="info-item"><span class="label">Rooms</span><span class="value">'+poi.osm_rooms+'</span></div>';
          if (poi.osm_beds) h += '<div class="info-item"><span class="label">Beds</span><span class="value">'+poi.osm_beds+'</span></div>';
          if (poi.osm_stars) h += '<div class="info-item"><span class="label">Star Rating</span><span class="value">'+poi.osm_stars+' stars</span></div>';
          h += '</div></div>';
        }

        // Cuisine
        if (isFood && cuisines.length) {
          h += '<div class="card"><h2>Cuisine</h2><div class="tags">';
          cuisines.forEach(function(c){h+='<span class="tag">'+esc(c)+'</span>';});
          h += '</div></div>';
        }

        // Services
        if (services.length) {
          h += '<div class="card"><h2>Services</h2><div class="tags">';
          services.forEach(function(s){h+='<span class="tag">'+esc(s)+'</span>';});
          h += '</div></div>';
        }

        // Amenities
        if (amenities.length) {
          h += '<div class="card"><h2>Amenities</h2><div class="amenities-grid">';
          amenities.forEach(function(a){h+='<div class="amenity"><span class="icon">'+a.i+'</span><span>'+esc(a.n)+'</span></div>';});
          h += '</div></div>';
        }

        // Accessibility
        if (access.length) {
          h += '<div class="card"><h2>Accessibility</h2><div class="tags">';
          access.forEach(function(a){h+='<span class="tag">'+esc(a)+'</span>';});
          h += '</div></div>';
        }

        // Reviews
        if (reviews.length) {
          h += '<div class="card"><h2>Reviews</h2><div class="carousel review-carousel" data-carousel><div class="carousel-track">';
          reviews.forEach(function(r) {
            h += '<div class="review-card"><div class="review-inner">';
            h += '<div class="review-author">'+esc(r.author)+'</div>';
            h += '<div class="review-rating">'+r.stars+'</div>';
            h += '<p class="review-text">'+esc(r.text)+'</p>';
            if (r.time) h += '<div class="review-date">'+esc(r.time)+'</div>';
            h += '</div></div>';
          });
          h += '</div>';
          if (reviews.length > 1) {
            h += '<div class="carousel-dots">';
            reviews.forEach(function(_,i){h+='<button class="carousel-dot'+(i===0?' active':'')+'" data-index="'+i+'"></button>';});
            h += '</div>';
          }
          h += '</div></div>';
        }

        h += '</div>'; // .content
        return h;
      }

      function initCarousels() {
        document.querySelectorAll('[data-carousel]').forEach(function(carousel) {
          var track = carousel.querySelector('.carousel-track');
          var dots = carousel.querySelectorAll('.carousel-dot');
          var count = track.children.length;
          if (count < 1) return;
          var current = 0, startX = 0, deltaX = 0, autoInterval = null;
          var autoDelay = parseInt(carousel.dataset.auto, 10) || 0;

          function goTo(index) {
            current = Math.max(0, Math.min(index, count - 1));
            track.style.transform = 'translateX(-' + (current * 100) + '%)';
            dots.forEach(function(d, i) { d.classList.toggle('active', i === current); });
          }
          function next() { goTo((current + 1) % count); }
          function startAuto() { if (autoDelay > 0 && count > 1) autoInterval = setInterval(next, autoDelay); }
          function stopAuto() { if (autoInterval) { clearInterval(autoInterval); autoInterval = null; } }

          startAuto();

          dots.forEach(function(dot) {
            dot.addEventListener('click', function() { stopAuto(); goTo(parseInt(dot.dataset.index, 10)); startAuto(); });
          });
          track.addEventListener('touchstart', function(e) {
            stopAuto(); startX = e.touches[0].clientX; deltaX = 0; track.style.transition = 'none';
          }, { passive: true });
          track.addEventListener('touchmove', function(e) {
            deltaX = e.touches[0].clientX - startX;
            track.style.transform = 'translateX(' + (-(current * 100) + (deltaX / track.offsetWidth * 100)) + '%)';
          }, { passive: true });
          track.addEventListener('touchend', function() {
            track.style.transition = 'transform 0.3s ease';
            goTo(current + (Math.abs(deltaX) > 50 ? (deltaX < 0 ? 1 : -1) : 0));
            startAuto();
          });
        });
      }

      // Boot: detect widget mode (ChatGPT Skybridge) vs server-side rendered
      function boot() {
        var poi = window.openai && window.openai.toolOutput;
        if (poi && typeof poi === 'object' && poi.osm_id) {
          document.body.innerHTML = renderPOI(poi);
        }
        initCarousels();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot);
      } else {
        boot();
      }
    })();
  </script>
</body>
</html>
