# Database Configuration (required)
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/travel

# Google Places API Key (optional - can also be stored in database app_config)
# Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=<google-api-key>

# Sentry DSN for error tracking (optional)
# Get your DSN from: https://sentry.io/settings/projects/<sentry-project>/keys/
SENTRY_DSN=

# ============================================================================
# Other Configuration (stored in database app_config table)
# ============================================================================
# The following settings are stored in the database for runtime configurability.
# See doc/database-setup.md for details.
#
# google_places_enabled     - Enable/disable Google Places enrichment (default: true)
# google_places_cache_hours - Hours to cache Google Places data (default: 168 = 7 days)
# google_api_daily_limit    - Daily API call limit (default: 100)
# telemetry_enabled         - Enable/disable telemetry (default: true)
# telemetry_sample_rate     - Trace sample rate 0.0-1.0 (default: 1.0)
# telemetry_environment     - Environment name (default: development)
# sentry_send_dev           - Send events in development (default: true)
# server_base_url           - Base URL for the server (e.g., https://mcp.example.com)
