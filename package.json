{
  "name": "hotel-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for hotel information using open data sources",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:http": "node src/index-http.js",
    "import": "node src/import-geonames.js",
    "import:extended": "node src/import-geonames-extended.js",
    "import:osm": "node src/import-osm.js",
    "dev": "node --watch src/index.js",
    "dev:http": "node --watch src/index-http.js"
