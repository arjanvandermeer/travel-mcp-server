{
  "name": "travel-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for travel information using GeoNames and OpenStreetMap data",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:http": "node src/index-http.js",
    "dev": "node --watch src/index.js",
    "dev:http": "node --watch src/index-http.js",
    "inspect": "npx @modelcontextprotocol/inspector node src/index.js",
    "inspect:http": "node src/index-http.js & sleep 2 && npx @modelcontextprotocol/inspector --transport streamable-http --url http://localhost:3000/mcp; kill %1 2>/dev/null",
    "inspect:watch": "nodemon --exec 'npx @modelcontextprotocol/inspector' node src/index.js",
   "db:init": "node src/init.js",
    "db:import-geonames": "node src/import-geonames-postgres.js",
    "db:import": "node src/import-osm-pbf.js",
    "db:refresh": "node src/refresh-imports.js",
    "db:optimize": "node src/optimize-db.js",
    "test": "node --test 'tests/unit/**/*.test.js' 'tests/integration/**/*.test.js'",
    "test:unit": "node --test 'tests/unit/**/*.test.js'",
    "test:integration": "node --test 'tests/integration/**/*.test.js'",
    "test:watch": "node --test --watch 'tests/**/*.test.js'",
    "test:coverage": "node --test --experimental-test-coverage 'tests/unit/**/*.test.js' 'tests/integration/**/*.test.js'",
    "test:legacy": "node tests/test-bangkok-postgres.js",
    "config": "node scripts/manage-config.js"
  },
  "keywords": [
    "mcp",
    "travel",
    "hotels",
    "geonames",
    "openstreetmap",
    "postgis"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@sentry/node": "^10.36.0",
    "dotenv": "^16.4.5",
    "handlebars": "^4.7.8",
    "osm-pbf-parser": "^2.3.0",
    "pg": "^8.16.3",
    "through2": "^4.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  },
  "overrides": {
    "minimatch": ">=10.2.1"
  }
}
