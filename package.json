{
  "name": "travel-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for travel information using GeoNames and OpenStreetMap data",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:http": "node src/index-http.js",
    "dev": "node --watch src/index.js",
    "dev:http": "node --watch src/index-http.js",
    "inspect": "npx @modelcontextprotocol/inspector node src/index.js",
    "inspect:http": "npx @modelcontextprotocol/inspector node src/index-http.js",
    "inspect:watch": "nodemon --exec 'npx @modelcontextprotocol/inspector' node src/index.js",
    "inspect:watch:http": "nodemon --exec 'npx @modelcontextprotocol/inspector' node src/index-http.js",
    "db:init": "node src/init.js",
    "db:import-geonames": "node src/import-geonames-postgres.js",
    "test": "node tests/test-bangkok-postgres.js",
    "config": "node scripts/manage-config.js"
  },
  "keywords": [
    "mcp",
    "travel",
    "hotels",
    "geonames",
    "openstreetmap",
    "postgis"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "dotenv": "^16.4.5",
    "osm-pbf-parser": "^2.3.0",
    "pg": "^8.16.3",
    "through2": "^4.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  }
}
