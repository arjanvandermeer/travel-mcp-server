{
  "name": "travel-mcp-server",
  "version": "1.1.0",
  "description": "MCP server for travel information using GeoNames and OpenStreetMap data",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:http": "node src/index-http.js",
    "dev": "node --watch src/index.js",
    "dev:http": "node --watch src/index-http.js",
    "inspect": "npx @modelcontextprotocol/inspector node src/index.js",
    "inspect:http": "node src/index-http.js & sleep 2 && npx @modelcontextprotocol/inspector --transport streamable-http --url http://localhost:3000/mcp; kill %1 2>/dev/null",
    "inspect:watch": "nodemon --exec 'npx @modelcontextprotocol/inspector' node src/index.js",
    "db:init": "node scripts/db-init.js",
    "db:reset": "node scripts/db-init.js --reset",
    "db:import-geonames": "node scripts/import-geonames.js",
    "db:import": "node scripts/import-osm.js",
    "db:refresh": "node scripts/refresh-imports.js",
    "db:optimize": "node scripts/optimize-db.js",
    "db:backfill-name-en": "node scripts/backfill-name-en.js",
    "test": "node --test 'tests/unit/**/*.test.js' 'tests/integration/**/*.test.js'",
    "test:unit": "node --test 'tests/unit/**/*.test.js'",
    "test:integration": "node --test 'tests/integration/**/*.test.js'",
    "test:watch": "node --test --watch 'tests/**/*.test.js'",
    "test:coverage": "node --test --experimental-test-coverage 'tests/unit/**/*.test.js' 'tests/integration/**/*.test.js'",
    "test:maintenance-gate-smoke": "node scripts/maintenance-review-smoke.js",
    "test:legacy": "node tests/test-bangkok-postgres.js",
    "config": "node scripts/manage-config.js",
    "lint": "eslint src/ scripts/",
    "lint:fix": "eslint src/ scripts/ --fix",
    "agent": "node slm/ollama-agent.js",
    "test:agent": "node slm/test-ollama-agent.js",
    "prepare": "husky || true"
  },
  "keywords": [
    "mcp",
    "travel",
    "hotels",
    "geonames",
    "openstreetmap",
    "postgis"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@sentry/node": "^10.36.0",
    "dotenv": "^16.4.5",
    "handlebars": "^4.7.8",
    "osm-pbf-parser": "^2.3.0",
    "pg": "^8.16.3",
    "thai-transliterate": "github:arjanvandermeer/thai-transliterate-js",
    "through2": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.1",
    "husky": "^9.1.7",
    "nodemon": "^3.1.11"
  },
  "overrides": {
    "minimatch": ">=10.2.1",
    "path-to-regexp": "8.4.2"
  }
}
